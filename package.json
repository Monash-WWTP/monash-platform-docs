{
  "name": "monash-platform-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "python3 -m http.server 3030 --directory out --bind 127.0.0.1",
    "types:check": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "generate:api": "node scripts/generate-api.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "^12.5.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "katex": "$katex"
  }
